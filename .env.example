NODE_ENV=development
PORT=3000
API_PORT=3000
SERVICE_NAME=Arkena Core
SERVICE_VERSION=1.0.0
LOG_LEVEL=info
DATABASE_URL=postgresql://postgres:postgres@db:5432/arkena_core?schema=public
JWT_ACCESS_SECRET=dev-access-secret-arkena-core-0123456789
JWT_REFRESH_SECRET=dev-refresh-secret-arkena-core-0123456789
JWT_RESET_SECRET=dev-reset-secret-arkena-core-0123456789
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
RESET_TOKEN_TTL=30m
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
TRUST_PROXY=1
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
BODY_SIZE_LIMIT=2mb
ENABLE_OPENAPI_DOCS=true
METRICS_ENABLED=true
METRICS_BEARER_TOKEN=
GRACEFUL_SHUTDOWN_TIMEOUT_MS=10000
READINESS_DB_TIMEOUT_MS=2000
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_BYTES=10485760
DEFAULT_SUPER_ADMIN_EMAIL=admin@arkena.local
DEFAULT_SUPER_ADMIN_PASSWORD=ChangeMe123!
DEFAULT_SUPER_ADMIN_FIRST_NAME=Super
DEFAULT_SUPER_ADMIN_LAST_NAME=Admin
DEFAULT_SUPER_ADMIN_PHONE=+0000000000
