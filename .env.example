NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@db:5432/arkena_core?schema=public
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_RESET_SECRET=change-me-reset-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
RESET_TOKEN_TTL=30m
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_BYTES=10485760
DEFAULT_SUPER_ADMIN_EMAIL=admin@arkena.local
DEFAULT_SUPER_ADMIN_PASSWORD=ChangeMe123!
DEFAULT_SUPER_ADMIN_FIRST_NAME=Super
DEFAULT_SUPER_ADMIN_LAST_NAME=Admin
DEFAULT_SUPER_ADMIN_PHONE=+0000000000
