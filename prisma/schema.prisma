generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  SUPER_ADMIN
  ADMIN
  HR
  MANAGER
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
  ARCHIVED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
}

enum DocumentType {
  CONTRACT
  ID_CARD
  ATTESTATION
  CV
  OTHER
}

enum NotificationType {
  INFO
  WARNING
  SUCCESS
  ERROR
  SYSTEM
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  REFRESH_TOKEN
  RESET_PASSWORD
  UPLOAD
  DOWNLOAD
  ASSIGN
}

enum ResetTokenPurpose {
  PASSWORD_RESET
  EMAIL_VERIFY
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  passwordHash     String
  firstName        String
  lastName         String
  phone            String?
  jobTitle         String?
  role             RoleName          @default(EMPLOYEE)
  status           UserStatus        @default(ACTIVE)
  emailVerifiedAt  DateTime?
  lastLoginAt      DateTime?
  employee         Employee?
  refreshTokens    RefreshToken[]
  resetTokens      PasswordResetToken[]
  notifications    Notification[]    @relation("NotificationRecipient")
  createdNotifications Notification[] @relation("NotificationCreator")
  auditLogs        AuditLog[]
  uploadedDocuments Document[]       @relation("DocumentUploader")
  attendanceRecords AttendanceRecord[] @relation("AttendanceRecorder")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([role])
  @@index([status])
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique
  description String?
  roleLinks   RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model RolePermission {
  role         RoleName
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())

  @@id([role, permissionId])
  @@index([permissionId])
}

model Department {
  id                String            @id @default(cuid())
  code              String            @unique
  name              String
  description       String?
  status            EmployeeStatus     @default(ACTIVE)
  managerEmployeeId String?           @unique
  managerEmployee   Employee?         @relation("DepartmentManager", fields: [managerEmployeeId], references: [id], onDelete: SetNull)
  employees        Employee[]
  attendanceRecords AttendanceRecord[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([status])
  @@index([name])
}

model Employee {
  id              String            @id @default(cuid())
  employeeNumber  String            @unique
  firstName       String
  lastName        String
  email           String            @unique
  phone           String?
  jobTitle        String?
  hireDate        DateTime
  status          EmployeeStatus    @default(ACTIVE)
  departmentId    String?
  department      Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  managerId       String?
  manager         Employee?         @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  directReports   Employee[]        @relation("EmployeeManager")
  userId          String?           @unique
  user            User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  documents       Document[]
  attendance      AttendanceRecord[]
  managedDepartment Department?      @relation("DepartmentManager")
  archivedAt      DateTime?
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([departmentId])
  @@index([managerId])
  @@index([status])
  @@index([firstName, lastName])
}

model AttendanceRecord {
  id              String           @id @default(cuid())
  employeeId      String
  employee        Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  departmentId    String?
  department      Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  attendanceDate  DateTime
  status          AttendanceStatus
  checkInAt       DateTime?
  checkOutAt      DateTime?
  comment         String?
  recordedByUserId String?
  recordedByUser  User?            @relation("AttendanceRecorder", fields: [recordedByUserId], references: [id], onDelete: SetNull)
  source          String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([employeeId, attendanceDate])
  @@index([attendanceDate])
  @@index([departmentId])
  @@index([status])
}

model Document {
  id              String          @id @default(cuid())
  employeeId      String
  employee        Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  uploadedByUserId String
  uploadedByUser  User            @relation("DocumentUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  type            DocumentType
  title           String
  description     String?
  originalName    String
  mimeType        String
  sizeInBytes     Int
  storageKey      String          @unique
  checksum        String?
  accessLevel     String          @default("PRIVATE")
  metadata        Json?
  deletedAt       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([employeeId])
  @@index([type])
  @@index([deletedAt])
}

model Notification {
  id                String           @id @default(cuid())
  recipientUserId    String
  recipientUser     User             @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  createdByUserId   String?
  createdByUser     User?            @relation("NotificationCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  type              NotificationType @default(INFO)
  title             String
  body              String
  resourceType      String?
  resourceId        String?
  metadata          Json?
  readAt            DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([recipientUserId, readAt])
  @@index([type])
}

model AuditLog {
  id            String      @id @default(cuid())
  actorUserId   String?
  actorUser     User?       @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action        AuditAction
  resource      String
  resourceId    String?
  ip            String?
  userAgent     String?
  beforeData    Json?
  afterData     Json?
  metadata      Json?
  createdAt     DateTime    @default(now())

  @@index([actorUserId])
  @@index([action])
  @@index([resource, resourceId])
}

model RefreshToken {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jti           String    @unique
  familyId      String
  tokenHash     String    @unique
  expiresAt     DateTime
  revokedAt     DateTime?
  replacedByJti String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId, revokedAt])
  @@index([familyId])
}

model PasswordResetToken {
  id            String             @id @default(cuid())
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose       ResetTokenPurpose  @default(PASSWORD_RESET)
  tokenHash     String             @unique
  expiresAt     DateTime
  usedAt        DateTime?
  requestedIp   String?
  requestedUserAgent String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([userId, purpose])
  @@index([expiresAt])
}

